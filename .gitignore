# ---------------------------------------------------------------------------
# colcon build output -- regenerated by "colcon build", never committed.
# (make_clean.sh removes exactly these three, plus logout/ and out/.)
# ---------------------------------------------------------------------------
/build/
/install/
/log/

# ---------------------------------------------------------------------------
# Runtime output of the robot itself. Recreated on every run; out/ in
# particular fills up with saved camera/lidar/navmap images very quickly.
#
# out/ and logout/ must EXIST before startup -- nothing creates them
# (cv::imwrite and log4cxx's RollingFileAppender both fail on a missing
# directory), so .gitkeep files keep the empty dirs in the repo while their
# contents stay ignored.
# ---------------------------------------------------------------------------
/out/*
!/out/.gitkeep
/logout/*
!/logout/.gitkeep

# ramdisk/ needs no .gitkeep: telemetry_node creates it itself
# (std::filesystem::create_directories on its output_dir parameter), so the
# whole directory can stay out of the repo. Also removed by make_clean.sh.
/ramdisk/

# ---------------------------------------------------------------------------
# Python virtualenv for the CPU/ONNX visionn server (~305 MB).
# Recreate with: script/visionn_segfb0_server/install/setup_cpu_infer_venv.sh
# ---------------------------------------------------------------------------
.venv*/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# visionn server scratch images -- img_output/ is generated by test runs.
# img_input/ IS kept: those are the fixed test inputs.
# ---------------------------------------------------------------------------
script/visionn_*_server/img_output/

# ---------------------------------------------------------------------------
# Archived AI session exports (~31 MB of .tgz). Historical record only --
# nothing in the build or the docs depends on them, and binary archives bloat
# git history permanently. Keep them outside the repo (or on a share).
# ---------------------------------------------------------------------------
doc/ai/claude/

# ---------------------------------------------------------------------------
# The legacy istro_rt2025 codebase (~61 MB, 38 MB of it .osm map data) that
# this project is a 1:1 port OF. Read-only reference: nothing here builds or
# runs it, and it lives in its own upstream project already -- keeping a
# second copy in this repo's history would roughly double its size for no
# gain.
#
# NOTE for a fresh clone (e.g. on the Jetson): doc/istrobtx_2025/ will be
# ABSENT there. The porting convention is "check the legacy source before
# concluding something in the port is a bug" (doc/ai/06_hw_testing_guide.md),
# so copy this directory in by hand if that kind of comparison is needed on
# that machine.
# ---------------------------------------------------------------------------
doc/istrobtx_2025/

# ---------------------------------------------------------------------------
# Run archives (archive/YYMMDD_name/): one run's out/ and logout/ moved aside
# so the next run starts clean, whether by script/mvout.sh or copied off the
# robot by hand for a one-off analysis. Tens of MB of .jpg/.log each -- the
# 2026-09-09 batch alone was 61 MB -- and they land in the workspace root,
# where a "git add -A" would otherwise sweep them straight into the repo.
#
# This is the ONLY place such dumps belong. doc/ is committed in full; it used
# to carry a doc/*_jetson_test/ exception for exactly these, which is gone now
# that they live here instead.
#
# If a particular capture turns out to be worth keeping as a permanent record,
# compress it (gzip gets these roughly 20x) and add it deliberately somewhere
# under doc/ with "git add -f".
#
# mvout.sh also writes a self-ignoring .gitignore into each dump, and archive/
# carries one of its own -- three layers, any one of which is enough alone.
#
# Written as /archive/* rather than a bare /archive/ (the out/ and logout/
# pattern above) so that archive/.gitignore itself stays tracked and the
# directory survives a clone. A bare /archive/ would stop git descending at
# all, and the stub could never be committed.
# ---------------------------------------------------------------------------
/archive/*
!/archive/.gitignore

# ---------------------------------------------------------------------------
# Credentials -- must never reach GitHub. Belt and braces: the recommended
# setup keeps the token in ~/.git-credentials (outside the repo) anyway.
# ---------------------------------------------------------------------------
.git-credentials
*.pem
*.key
.env

# ---------------------------------------------------------------------------
# Editor / OS noise
#
# .vscode/ is ignored EXCEPT settings.json, which is project configuration
# rather than personal preference: it keeps the C/C++ language server and the
# file watcher off this project's own generated directories (build/, install/,
# out/, logout/, ramdisk/, .venv_rosvm/). Without it cpptools re-parses ~709
# generated files against 91 real ones and sat at ~39% CPU on the dev VM --
# more than the NN inference server. Worth carrying to the next machine
# instead of rediscovering. Anything else under .vscode/ (launch.json with
# local paths, per-user tweaks) stays ignored.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
